[Unit]
Description=Monitor VzBADris storefront, database, payments and integrations
After=network-online.target vzbadrys.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/vzbadrys/vzbadrys.env
WorkingDirectory=/opt/vzbadrys
ExecStart=/usr/bin/node /opt/vzbadrys/scripts/monitor-site-health.mjs
User=root
StateDirectory=vzbadrys-monitor
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vzbadrys-monitor
