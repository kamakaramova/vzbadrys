[Unit]
Description=Sync VzBADris payment statuses and reconcile loyalty bonuses
After=network-online.target vzbadrys.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/vzbadrys/vzbadrys.env
WorkingDirectory=/opt/vzbadrys
ExecStart=/usr/bin/node /opt/vzbadrys/scripts/sync-ozon-payment-statuses.mjs
User=root
